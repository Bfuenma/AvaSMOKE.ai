# Public Supabase values. Prefer the modern publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# AI calls stay server-side. Never prefix provider keys with NEXT_PUBLIC_.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Public canonical origin, used in QR destinations.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enables clearly labeled development fixtures when Supabase is unavailable.
ENABLE_DEVELOPMENT_FALLBACK=true
